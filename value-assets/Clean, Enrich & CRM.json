    {
      "parameters": {
        "jsCode": "// ── PRINCIPE (board) · Étape 3 · Normaliser & dédupliquer ──────────────\n// Conseil 1 : clé stable  ·  Conseil 2 : normaliser le référentiel  ·  Conseil 3 : garde-fous\n// On produit une CLÉ STABLE (link_canonical) AVANT toute dédup — jamais sur le nom.\n\nfunction str(v){ return (v ?? '').toString(); }\nfunction clean(v){ return str(v).replace(/\\s+/g, ' ').trim(); }\nfunction titleCase(v){\n  return clean(v).toLowerCase().replace(/\\b\\p{L}/gu, c => c.toUpperCase());\n}\nfunction canonicalLinkedIn(url){\n  let u = clean(url).toLowerCase();\n  if(!u) return '';\n  u = u.replace(/^https?:\\/\\//, '').replace(/^www\\./, '');\n  u = u.split('?')[0].split('#')[0];\n  u = u.replace(/\\/+$/, '');\n  const m = u.match(/linkedin\\.com\\/in\\/([^/]+)/);\n  return m ? `linkedin.com/in/${m[1]}` : '';\n}\n\nconst out = [];\nfor (const item of $input.all()){\n  const d = item.json || {};\n  const link_canonical = canonicalLinkedIn(d.link);\n  if (!link_canonical) continue;                       // GARDE-FOU 1\n  const firstName   = titleCase(d.firstName);\n  const lastName    = titleCase(d.lastName);\n  const fullName    = clean(d.fullName) || `${firstName} ${lastName}`.trim();\n  const title       = clean(d.title);\n  const description = clean(d.description);\n  if (!fullName && !title) continue;                   // GARDE-FOU 2\n  out.push({ json: { ...d, firstName, lastName, fullName, title, description,\n                     link: clean(d.link), link_canonical } });\n}\nreturn out;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2752,
        1344
      ],
      "id": "9b9a60e5-b38f-4e61-a4a1-df2ae0979b91",
      "name": "Normalize & Validate"
    },
    {
      "parameters": {
        "compare": "selectedFields",
        "fieldsToCompare": "link_canonical",
        "options": {}
      },
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        2976,
        1344
      ],
      "id": "16180aa5-a887-4f71-9d96-c0e9d5b4dbc9",
      "name": "Remove Duplicates (clé stable)"
    },
    {
      "parameters": {
        "jsCode": "// ── Filtre ICP — payeur cible ─────────────────────────────────────────\n// CRO · VP Sales · RevOps Lead · Head of Sales Ops (FR + EN)\nconst ICP_TITLE_REGEX = /\\b(?:CRO|Chief\\s+Revenue\\s+Officer|(?:VP|SVP|V\\.?P\\.?|Vice[-\\s]?President)\\s+(?:of\\s+)?Sales|(?:VP|SVP)\\s+Revenue|(?:Directeur|Directrice)\\s+Commercial(?:e)?|Rev[\\s-]?Ops\\s+(?:Lead|Manager|Director|Head)|Revenue\\s+Operations\\s+(?:Lead|Manager|Director|Head)|Sales\\s+Op(?:s|erations)\\s+(?:Lead|Manager|Director|Head)|Head\\s+of\\s+(?:Sales|Revenue)\\s+Operations|Head\\s+of\\s+Rev[\\s-]?Ops|Head\\s+of\\s+Sales)\\b/i;\nreturn $input.all().filter(item => {\n  const value = `${item.json.title ?? ''} ; ${item.json.description ?? ''}`;\n  return ICP_TITLE_REGEX.test(value);\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3200,
        1344
      ],
      "id": "d7eff5ad-40ea-4109-b76d-1fc5bad15c0e",
      "name": "Only ICP"
    },
    {
      "parameters": {
        "jsCode": "// ── Scoring ICP CRM RevOps (/10) — niveau PERSONNE ────────────────────\nfunction str(v){ return (v ?? '').toString().toLowerCase(); }\nfunction clamp(n, min, max){ return Math.max(min, Math.min(max, n)); }\nfunction has(text, arr){ return arr.some(k => text.includes(k)); }\nreturn $input.all().map(item => {\n  const d = item.json || {};\n  const title = str(d.title), desc = str(d.description);\n  const blob = `${title} ; ${desc}`;\n  let role = 1;\n  if (has(title, ['cro', 'chief revenue officer'])) role = 4;\n  else if (/\\b(vp|svp|vice[-\\s]?president)\\b/.test(title) && has(title, ['sales','revenue','commercial'])) role = 4;\n  else if (has(title, ['head of revops','head of revenue operations','head of sales operations','director of revenue operations','revops director'])) role = 4;\n  else if (has(title, ['revops lead','revenue operations lead','revenue operations manager','head of sales ops','head of sales','director of sales','sales operations manager','directeur commercial','directrice commercial'])) role = 3;\n  else if (has(title, ['revops','rev ops','revenue operations','sales ops','sales operations'])) role = 2;\n  let fonction = 0;\n  if (has(blob, ['revops','rev ops','revenue operations','sales operations','sales ops'])) fonction = 2;\n  else if (has(blob, ['revenue','commercial','sales'])) fonction = 1;\n  const STACK = ['attio','folk','close crm','pipedrive','hubspot','salesforce','crm','forecast','pipeline','gtm','sales stack','outreach','modjo','aircall'];\n  const stack = clamp(STACK.filter(k => blob.includes(k)).length, 0, 2);\n  const stage = has(blob, ['scaleup','scale-up','series a','series b','series c','hypergrowth','b2b saas','saas','50-','100-','200-']) ? 1 : 0;\n  const geo = has(blob, ['france','paris','lyon','montpellier','🇫🇷','français','french']) ? 1 : 0;\n  const total = clamp(role + fonction + stack + stage + geo, 0, 10);\n  const fit = total >= 8 ? 'Fort' : total >= 5 ? 'Moyen' : 'Faible';\n  d.icp_score = total; d.icp_fit = fit;\n  d.icp_priority = fit === 'Fort' ? 'P1' : fit === 'Moyen' ? 'P2' : 'P3';\n  d.icp_scoring = { score_total: total, fit_icp: fit, breakdown: { role, fonction, stack, stage, geo } };\n  return { json: d };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3424,
        1344
      ],
