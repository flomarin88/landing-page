    {
      "parameters": {
        "jsCode": "// ── Score Company (ICP société) — d'après les données Pappers ─────────\n// Cible : scaleup B2B SaaS FR, 50-300 pers. (CA · effectif · secteur NAF)\nfunction num(v){ const n = Number(v); return isNaN(n) ? 0 : n; }\nreturn $input.all().map(item => {\n  const d = item.json || {};\n  const p = d.pappers || d;\n  const effectif = num(p.effectif ?? d.headcount);\n  const ca = num(p.chiffre_affaires ?? d.ca);\n  const naf = (p.libelle_code_naf ?? p.code_naf ?? d.secteur ?? '').toString().toLowerCase();\n\n  let score = 0;\n  if (effectif >= 50 && effectif <= 300) score += 4;          // cœur de cible\n  else if (effectif >= 30 && effectif < 50) score += 2;\n  else if (effectif > 300 && effectif <= 500) score += 2;\n  if (ca >= 5e6 && ca <= 100e6) score += 3;                    // CA scaleup\n  else if (ca > 0) score += 1;\n  if (/(logiciel|software|saas|edition|informatique|programmation|6201|6202|5829|6311)/.test(naf)) score += 3;\n\n  const company_fit = score >= 7 ? 'Fort' : score >= 4 ? 'Moyen' : 'Faible';\n  d.company_fit = company_fit;\n  d.company_scoring = { score_total: score, company_fit, inputs: { effectif, ca, naf } };\n  return { json: d };\n});\n"
      },
